DATABASE_URL="postgresql://sprig:sprig@localhost:5432/sprig?schema=public"

# Only needed against a pooled Postgres (e.g. Neon's "-pooler" endpoint).
# `prisma migrate deploy`/`migrate dev` need a direct, unpooled connection —
# see the comment in prisma.config.ts. Point this at Neon's direct connection
# string (same host, without "-pooler"). Leave unset for a local/non-pooled
# Postgres; DATABASE_URL is used as the fallback.
# DIRECT_URL="postgresql://sprig:sprig@ep-xxxx.us-east-2.aws.neon.tech/sprig?schema=public"

# Vercel Blob read/write token (Storage tab in your Vercel project, or
# `vercel blob token create`)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_YOUR_TOKEN"
