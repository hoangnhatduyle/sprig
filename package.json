    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "suncalc": "^2.0.1",
    "three": "^0.185.1",
    "xstate": "^5.32.5",
    "zustand": "^5.0.14"
